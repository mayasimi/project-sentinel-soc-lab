<!-- Project Sentinel: Guest account enablement detection -->
<group name="windows,account_management,">

  <rule id="100200" level="12">
    <if_sid>60100</if_sid>
    <field name="win.system.eventID">^4722$</field>
    <field name="win.eventdata.targetUserName"
           type="pcre2">^Guest$</field>
    <description>
      Windows Guest account was enabled (Event ID 4722).
    </description>
  </rule>

</group>
